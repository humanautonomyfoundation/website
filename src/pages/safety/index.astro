---
import Base from '../../layouts/Base.astro';
import Wordmark from '../../components/Wordmark.astro';
import { SITE } from '../../consts';

// The pages themselves are self-contained HTML in public/safety/.
const start = {
  title: 'AI Risk Landscape',
  href: '/safety/landscape.html',
  blurb:
    'A start-here overview of AI risk: who or what causes it, how the risks connect, where defenses stand, and which research gaps matter most.',
};

const groups = [
  {
    id: 'risks',
    label: 'The risks',
    intro: 'What can go wrong, and where.',
    pages: [
      {
        title: 'AI Safety Atlas',
        href: '/safety/atlas.html',
        blurb:
          'An interactive map of protections and weak points for people and organizations using already-trained AI models, including prompt injection, memory leakage and weaker protection in non-English languages.',
      },
      {
        title: 'AI Catastrophe Pathways',
        href: '/safety/pathways.html',
        blurb:
          'How AI could contribute to large-scale catastrophe, step by step, with the evidence for each step, recent incidents, and where people can still intervene.',
      },
      {
        title: 'Society & Critical Systems',
        href: '/safety/society.html',
        blurb:
          'AI risks across finance, health, energy, elections, jobs and other critical systems, with measured evidence and incidents.',
      },
    ],
  },
  {
    id: 'response',
    label: 'The response',
    intro: 'How AI is governed, measured and defended.',
    pages: [
      {
        title: 'AI Governance Map',
        href: '/safety/governance.html',
        blurb:
          'AI laws, orders and policies by jurisdiction, with a timeline and the live debates.',
      },
      {
        title: 'Measuring AI Safety',
        href: '/safety/measuring.html',
        blurb:
          'How AI safety is measured, nine ways measurement goes wrong, whether test results predict real behavior, and a close look at sycophancy and honesty.',
      },
      {
        title: 'AI Defense Stack',
        href: '/safety/defense.html',
        blurb:
          'Where each safety defense sits, from training data to an agent taking an action, what it catches, where it fails, and which threats slip through every layer.',
      },
    ],
  },
  {
    id: 'perspectives',
    label: 'Perspectives',
    intro: 'What experts say, who is working on it, and how fiction compares.',
    pages: [
      {
        title: 'What the Experts Say',
        href: '/safety/experts.html',
        blurb:
          'What researchers, governments and other authoritative sources say about AI risk, alignment, security, governance and evaluation.',
      },
      {
        title: 'AI Safety Ecosystem',
        href: '/safety/ecosystem.html',
        blurb:
          'The organizations, funders and landmark papers that make up the AI safety field, and where a new research group would fit.',
      },
      {
        title: 'AI Fiction Atlas',
        href: '/safety/fiction.html',
        blurb:
          'Famous AI stories from film, books, TV and games, mapped to real risk scenarios and checked against research.',
      },
    ],
  },
  {
    id: 'deep-dives',
    label: 'Deep dives',
    intro: 'The technical detail behind our top research priority.',
    pages: [
      {
        title: 'Evaluations That Predict Real-World Failures',
        href: '/safety/evals-deep-dive.html',
        blurb:
          'The core technical problem, six sub-areas to master, a six-month pilot project, and the sources to study in order.',
      },
      {
        title: 'Paper Deep Dives',
        href: '/safety/papers.html',
        blurb:
          'Fourteen key papers and reports on eval validity, test awareness, sandbagging, statistics and real incidents, each with method, key numbers, limitations and how to use it.',
      },
    ],
  },
];

// Our ranking of where research would do the most good. Our own analysis.
const priorities = [
  {
    rank: 1,
    title: 'Evaluations that predict real-world failures',
    why: 'Safety decisions rest on pre-release tests, but no one has shown that test scores predict how deployed AI agents fail. Models also increasingly notice when they are being tested.',
    work: 'Test whether scores predict deployment failures, measure how behavior shifts between tests and real use, and detect deliberate underperformance.',
    links: [
      { label: 'Deep dive', href: '/safety/evals-deep-dive.html' },
      { label: '14 paper deep dives', href: '/safety/papers.html' },
    ],
  },
  {
    rank: 2,
    title: 'Incident measurement and evidence-based safety cases',
    why: 'No one can say how often deployed agents misbehave, because incident reports lack shared formats and exposure figures. Safety cases rarely connect to what actually happens.',
    work: 'A common way to record incidents, failure rates with denominators such as agent-hours, and tests of whether safety cases predict fewer incidents.',
    links: [{ label: 'Where it sits in the stack', href: '/safety/defense.html' }],
  },
  {
    rank: 3,
    title: 'Safety that survives training, adaptation and updates',
    why: 'A model that passes safety tests at release keeps changing through fine-tuning, compression, merging and further training. Safety can erode at each step, and cheating learned in training can spread.',
    work: 'Map which everyday changes break safety across model families, and find cheap regression checks that catch it before deployment.',
    links: [{ label: 'The defenses involved', href: '/safety/defense.html' }],
  },
];

const paths = [
  {
    who: 'New to AI risk',
    steps: [
      { title: 'AI Risk Landscape', href: '/safety/landscape.html' },
      { title: 'AI Fiction Atlas', href: '/safety/fiction.html' },
      { title: 'What the Experts Say', href: '/safety/experts.html' },
    ],
  },
  {
    who: 'Building or deploying AI',
    steps: [
      { title: 'AI Safety Atlas', href: '/safety/atlas.html' },
      { title: 'AI Defense Stack', href: '/safety/defense.html' },
      { title: 'Measuring AI Safety', href: '/safety/measuring.html' },
    ],
  },
  {
    who: 'Research and policy',
    steps: [
      { title: 'AI Catastrophe Pathways', href: '/safety/pathways.html' },
      { title: 'AI Governance Map', href: '/safety/governance.html' },
      { title: 'Evals deep dive', href: '/safety/evals-deep-dive.html' },
    ],
  },
];

const pageCount = 1 + groups.reduce((n, g) => n + g.pages.length, 0);
const year = new Date().getFullYear();
---

<Base
  title="AI Safety"
  description="Reference pages on AI risk: what can go wrong, how it is governed, measured and defended, what experts say, and where research should focus."
>
  <div class="shell">
    <header class="top">
      <Wordmark href="/" />
    </header>

    <main>
      <div class="intro">
        <p class="eyebrow">Reference set</p>
        <h1>AI Safety</h1>
        <p class="lede">
          Reference pages on AI risk: what can go wrong, how it is governed,
          measured and defended, what experts say, and where research would do
          the most good. Most are interactive.
        </p>
        <p class="meta">
          <span>{pageCount} pages</span>
          <span aria-hidden="true">·</span>
          <span>Sources checked 3 November 2026</span>
          <span aria-hidden="true">·</span>
          <span>Updated 3 November 2026</span>
        </p>
      </div>

      <a class="start" href={start.href}>
        <span class="start-text">
          <span class="kicker">Start here</span>
          <span class="start-title">{start.title}</span>
          <span class="blurb">{start.blurb}</span>
        </span>
        <span class="start-go" aria-hidden="true">&rarr;</span>
      </a>

      <section aria-labelledby="g-focus" class="focus">
        <header class="group-head">
          <h2 id="g-focus">Where research should focus</h2>
          <p>Our ranking of the three research areas that would do the most good.</p>
        </header>
        <ol class="prio">
          {
            priorities.map((p) => (
              <li class="prio-card">
                <span class="prio-rank" aria-hidden="true">{p.rank}</span>
                <div class="prio-body">
                  <h3>{p.title}</h3>
                  <p class="blurb">{p.why}</p>
                  <p class="prio-work"><span>The work:</span> {p.work}</p>
                  <p class="prio-links">
                    {p.links.map((l) => (
                      <a href={l.href}>{l.label} &rarr;</a>
                    ))}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
        <p class="note">
          Ranked on impact, feasibility, how few groups work on each, and fit
          with major safety funders. Also important: control and monitoring
          that hold up when a model works against them, and hard limits on
          what AI agents' tools can do. This ranking is our own analysis.
        </p>
      </section>

      <section aria-labelledby="g-paths">
        <header class="group-head">
          <h2 id="g-paths">Reading paths</h2>
          <p>Three ways through the set, depending on why you're here.</p>
        </header>
        <ul class="paths">
          {
            paths.map((path) => (
              <li class="path">
                <span class="kicker">{path.who}</span>
                <ol>
                  {path.steps.map((st) => (
                    <li><a href={st.href}>{st.title}</a></li>
                  ))}
                </ol>
              </li>
            ))
          }
        </ul>
      </section>

      {
        groups.map((group) => (
          <section aria-labelledby={`g-${group.id}`}>
            <header class="group-head">
              <h2 id={`g-${group.id}`}>{group.label}</h2>
              <p>{group.intro}</p>
            </header>
            <ul class="cards">
              {group.pages.map((page) => (
                <li>
                  <a class="card" href={page.href}>
                    <span class="card-title">{page.title}</span>
                    <span class="blurb">{page.blurb}</span>
                    <span class="card-go" aria-hidden="true">
                      Open &rarr;
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </main>

    <footer>
      <p>&copy; {year} {SITE.name}</p>
    </footer>
  </div>
</Base>

<style>
  .shell {
    --wide: 64rem;
    --radius: 8px;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding: clamp(1.5rem, 5vw, 4rem);
    gap: clamp(2.5rem, 6vw, 4rem);
  }

  .top,
  main,
  footer {
    max-width: var(--wide);
    margin-inline: auto;
    width: 100%;
  }

  /* --- intro ----------------------------------------------------- */
  .intro {
    max-width: 38rem;
  }

  .eyebrow,
  .kicker,
  h2 {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .eyebrow {
    margin-bottom: 0.75rem;
    color: var(--ink-faint);
  }

  h1 {
    margin: 0 0 1.25rem;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2.5rem, 1.4rem + 4.4vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .lede {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.55;
    color: var(--ink-muted);
    text-wrap: pretty;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.6rem;
    margin: 1.25rem 0 0;
    font-size: 0.8125rem;
    color: var(--ink-faint);
  }

  /* --- start here ------------------------------------------------ */
  .start {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2.75rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--rule));
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--accent) 7%, var(--bg-elev));
    color: inherit;
    text-decoration: none;
    transition: border-color 150ms ease;
  }

  .start-text {
    display: grid;
    gap: 0.5rem;
    flex: 1;
    max-width: 40rem;
  }

  .kicker {
    color: var(--accent);
  }

  .start-title {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.1rem);
    line-height: 1.15;
  }

  .start-go {
    flex: none;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-left: auto;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 1.25rem;
    transition: transform 150ms ease;
  }

  .start:hover {
    border-color: var(--accent);
  }

  .start:hover .start-go {
    transform: translateX(3px);
  }

  @media (max-width: 30rem) {
    .start {
      gap: 1rem;
    }

    .start-go {
      width: 2.25rem;
      height: 2.25rem;
      font-size: 1rem;
    }
  }

  /* --- groups ---------------------------------------------------- */
  section {
    margin-top: clamp(2.75rem, 6vw, 4rem);
  }

  .group-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 1rem;
    padding-bottom: 0.9rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--rule);
  }

  h2 {
    color: var(--ink-faint);
  }

  .group-head p {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    height: 100%;
    padding: 1.25rem 1.3rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--bg-elev);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 150ms ease,
      transform 150ms ease;
  }

  .card-title {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    line-height: 1.25;
  }

  .blurb {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--ink-muted);
    text-wrap: pretty;
  }

  .card-go {
    margin-top: auto;
    padding-top: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--ink-faint);
    transition: color 150ms ease;
  }

  .card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .card:hover .card-go {
    color: var(--accent);
  }

  /* --- priorities ------------------------------------------------ */
  .prio {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .prio-card {
    display: flex;
    gap: 1.25rem;
    padding: 1.25rem 1.3rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--bg-elev);
  }

  .prio-card:first-child {
    border-color: color-mix(in srgb, var(--accent) 35%, var(--rule));
    background: color-mix(in srgb, var(--accent) 5%, var(--bg-elev));
  }

  .prio-rank {
    flex: none;
    font-family: var(--font-serif);
    font-size: 2.4rem;
    line-height: 1;
    color: var(--accent);
    min-width: 1.6rem;
  }

  .prio-body {
    display: grid;
    gap: 0.5rem;
    min-width: 0;
  }

  .prio-body h3 {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 1.3rem;
    line-height: 1.25;
  }

  .prio-body p {
    margin: 0;
  }

  .prio-work {
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .prio-work span {
    font-weight: 600;
  }

  .prio-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .prio-links a {
    color: var(--accent);
    text-decoration: none;
  }

  .prio-links a:hover {
    text-decoration: underline;
  }

  .note {
    margin: 1rem 0 0;
    max-width: 44rem;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--ink-faint);
  }

  /* --- reading paths --------------------------------------------- */
  .paths {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 44rem) {
    .paths {
      grid-template-columns: 1fr;
    }
  }

  .path {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }

  .path ol {
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.3rem;
    font-size: 0.9375rem;
  }

  .path a {
    color: inherit;
    text-underline-offset: 3px;
  }

  .path a:hover {
    color: var(--accent);
  }

  /* --- footer ---------------------------------------------------- */
  footer {
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  footer p {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--ink-faint);
  }
</style>
