---
import Base from '../layouts/Base.astro';
import Wordmark from '../components/Wordmark.astro';
import { SITE } from '../consts';

const year = new Date().getFullYear();
---

<Base>
  <div class="shell">
    <header class="top">
      <Wordmark />
      <p class="status">
        <span class="dot" aria-hidden="true"></span>
        Site coming soon
      </p>
    </header>

    <main class="stack">
      <h1>{SITE.tagline}</h1>

      <p class="lede">
        The Human Autonomy Foundation is an independent organization working to
        keep human agency, choice, and self&#8209;determination at the center of
        a world increasingly run by automated systems.
      </p>

      <p class="body">
        We carry out this work together with member organizations that share the
        commitment. If your organization would like to take part, we would be
        glad to hear from you.
      </p>

      <dl class="facts">
        <div>
          <dt>Status</dt>
          <dd>{SITE.status}</dd>
        </div>
        <div>
          <dt>Members</dt>
          <dd>Open to organizations that share our mission</dd>
        </div>
        <div>
          <dt>Contact</dt>
          <dd>
            <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>
          </dd>
        </div>
      </dl>
    </main>

    <footer>
      <p>&copy; {year} {SITE.name}</p>
    </footer>
  </div>
</Base>

<style>
  .shell {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding: clamp(1.5rem, 5vw, 4rem);
    gap: 3rem;
  }

  .top,
  .stack,
  footer {
    max-width: var(--measure);
    margin-inline: auto;
    width: 100%;
  }

  /* --- header ---------------------------------------------------- */
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--bg-elev);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--ink-muted);
  }

  .dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse 2.4s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  /* --- main ------------------------------------------------------ */
  .stack {
    margin-block: auto;
    padding-block: 2rem;
  }

  h1 {
    margin: 0 0 1.5rem;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2rem, 1.2rem + 3.4vw, 3.25rem);
    line-height: 1.12;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .lede {
    margin: 0 0 1.25rem;
    font-size: 1.125rem;
    line-height: 1.55;
    color: var(--ink);
    text-wrap: pretty;
  }

  .body {
    margin: 0;
    font-size: 1rem;
    color: var(--ink-muted);
    text-wrap: pretty;
  }

  /* --- facts ----------------------------------------------------- */
  .facts {
    display: grid;
    gap: 0.9rem;
    margin: 2.75rem 0 0;
    padding-top: 1.75rem;
    border-top: 1px solid var(--rule);
  }

  .facts > div {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 1rem;
    align-items: baseline;
  }

  .facts dt {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .facts dd {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .facts a {
    color: var(--ink);
    text-decoration-color: var(--accent);
    transition: color 120ms ease;
  }

  .facts a:hover {
    color: var(--accent);
  }

  @media (max-width: 30rem) {
    .facts > div {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }

  /* --- footer ---------------------------------------------------- */
  footer {
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  footer p {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--ink-faint);
  }
</style>
